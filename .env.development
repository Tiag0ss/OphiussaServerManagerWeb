# Loaded automatically by Next.js for `npm run dev`
# Data lives in ./data — no need to export DATA_DIR
AUTH_SECRET=dev-only-ophiussa-change-in-production
# Avoid bind-mount / mixed-owner .next (Turbopack EACCES)
OPHIUSSA_DIST_DIR=/tmp/ophiussa-next
# Network mode: auto (try isolated bridge+ports). Do not use host on Docker Desktop —
# host there is the VM, so game ports never appear and clients cannot connect.
OPHIUSSA_NETWORK_MODE=auto
