# Loaded automatically by Next.js for `npm run dev`
# Data lives in ./data by default (see src/lib/paths.ts)
AUTH_SECRET=dev-only-ophiussa-change-in-production

# Dev: write Next/Turbopack output outside the repo (avoids EACCES on .next)
# OPHIUSSA_DIST_DIR=/tmp/ophiussa-next

# Docker API socket. If you use Docker Desktop UI, point here so containers show up:
# DOCKER_SOCKET=/home/YOU/.docker/desktop/docker.sock
# System Engine (default): /var/run/docker.sock
# DOCKER_SOCKET=/var/run/docker.sock

# Network mode for game containers: auto (default) | bridge | host
# auto = try isolated bridge+ports; host is skipped on Docker Desktop (VM, no LAN ports)
# OPHIUSSA_NETWORK_MODE=auto
